{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "corepack enable && pnpm install --frozen-lockfile --filter @neongate-ai/orbz --filter @orbz/example-vanilla",
  "buildCommand": "pnpm --filter @neongate-ai/orbz build && pnpm --filter @orbz/example-vanilla build",
  "outputDirectory": "dist"
}
