{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "corepack enable && pnpm install --frozen-lockfile --filter @neongate-ai/orbz --filter @orbz/example-angular",
  "buildCommand": "pnpm --filter @neongate-ai/orbz build && pnpm --filter @orbz/example-angular build",
  "outputDirectory": "dist/orbz-angular-example/browser"
}
