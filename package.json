{
  "name": "@neongate-ai/orbz",
  "version": "0.2.0",
  "description": "A framework-agnostic, customizable AI voice orb built as a strict, SSR-safe web component.",
  "type": "module",
  "license": "MIT",
  "author": "Neongate AI <dev.neongate@gmail.com>",
  "main": "./dist/orbz.js",
  "module": "./dist/orbz.js",
  "types": "./dist/orbz.d.ts",
  "unpkg": "./dist/standalone/orbz.js",
  "jsdelivr": "./dist/standalone/orbz.js",
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.32.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeonGate-AI/orbz.git"
  },
  "bugs": {
    "url": "https://github.com/NeonGate-AI/orbz/issues"
  },
  "homepage": "https://orbz.site",
  "keywords": [
    "ai-voice",
    "voice-ui",
    "framework-agnostic",
    "react",
    "angular",
    "svelte",
    "vue",
    "ssr",
    "microfrontend",
    "web-components",
    "custom-elements"
  ],
  "scripts": {
    "build": "tsdown && tsdown --config tsdown.standalone.config.ts",
    "typecheck": "tsc --noEmit",
    "examples": "pnpm build && pnpm --filter \"@orbz/example-*\" build",
    "vanilla": "pnpm --filter @orbz/example-vanilla preview",
    "react": "pnpm --filter @orbz/example-react preview",
    "vue": "pnpm --filter @orbz/example-vue preview",
    "svelte": "pnpm --filter @orbz/example-svelte preview",
    "angular": "pnpm --filter @orbz/example-angular preview",
    "next": "pnpm --filter @orbz/example-next start",
    "docs": "pnpm docs:build && pnpm docs:start",
    "docs:build": "pnpm --filter @orbz/docs build",
    "docs:start": "pnpm --filter @orbz/docs start",
    "prepack": "pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "tsdown": "0.22.14",
    "typescript": "5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/orbz.d.ts",
      "import": "./dist/orbz.js",
      "default": "./dist/orbz.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./standalone": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/standalone/orbz.js",
      "default": "./dist/standalone/orbz.js"
    },
    "./index.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/browser.js",
    "./dist/index.css",
    "./dist/standalone/orbz.js"
  ]
}
